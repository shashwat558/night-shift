{
  "name": "nightshift-supervisor",
  "private": true,
  "type": "module",
  "description": "Night Shift shift-supervisor: Switch agent-protocol client that runs the overnight loop (goal in, taskslips out, workers spawned, PRs opened).",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "supervisor": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/test/*.test.js",
    "report": "node dist/src/cli.js report"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
